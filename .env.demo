# =====================================================================
# DEMO PROFILE — small/fast local Ollama models for live walkthroughs.
# Architecture, agents, graph, and component wiring are identical to
# production; only model size, keep-alive, and timeouts change.
# Switch back with:  pwsh scripts/use-env.ps1 production
# =====================================================================

TRADING_MODE=live

# --- LLM: small Qwen variants run ~10-20x faster than gemma4:latest ---
LLM_PROVIDER=ollama
DEEP_THINK_LLM=qwen2.5:3b
QUICK_THINK_LLM=qwen2.5:1.5b
LLM_FALLBACK_ENABLED=true
LLM_PREFER_FALLBACK=true
FALLBACK_LLM_PROVIDER=ollama
FALLBACK_DEEP_THINK_LLM=qwen2.5:3b
FALLBACK_QUICK_THINK_LLM=qwen2.5:1.5b

# Keep models resident in VRAM/RAM between calls so cold-load
# doesn't dominate wall-clock on each agent hop.
OLLAMA_KEEP_ALIVE=30m

# Raise timeout while you measure; demo runs should finish in 60-180s,
# but this prevents one slow node from killing the whole pipeline.
TRADINGAGENTS_ANALYSIS_TIMEOUT_SECONDS=1200

WATCHLIST_ENABLED=true
WATCHLIST_CHECK_INTERVAL=60

TRADINGAGENTS_AUTO_TRADE=false
TRADINGAGENTS_AUTO_TRADE_PAPER_ONLY=true
TRADINGAGENTS_TRADE_COMMENT=TradingAgent2.0
TRADINGAGENTS_MAX_RISK_PERCENT=0.5

MT5_USE_MOCK=false
