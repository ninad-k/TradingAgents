# Trading Mode: "paper" (demo/safe) or "live" (real money).
# Default is "live" — the dashboard reflects whichever MT5 terminal you attach to,
# so demo vs real is controlled by the terminal, not this flag.
# Auto-trading still requires explicit opt-in via TRADINGAGENTS_AUTO_TRADE.
TRADING_MODE=live

# LLM Provider — defaults to local Ollama (Owen) model, no API key required
# Change to "openai", "anthropic", etc. to use cloud providers
LLM_PROVIDER=ollama
DEEP_THINK_LLM=gemma4:latest
QUICK_THINK_LLM=gemma4:latest
LLM_FALLBACK_ENABLED=true
LLM_PREFER_FALLBACK=true
FALLBACK_LLM_PROVIDER=ollama
FALLBACK_DEEP_THINK_LLM=gemma4:latest
FALLBACK_QUICK_THINK_LLM=gemma4:latest

# --- Hybrid: local Ollama for quick agents, Hugging Face for deep agents ---
# DEEP_THINK_PROVIDER / QUICK_THINK_PROVIDER override the provider per tier.
# When unset, both tiers use LLM_PROVIDER above. For a hybrid, keep the quick
# (high-volume) agents on free local Ollama and route only the deep/reasoning
# agents to Hugging Face's OpenAI-compatible router (needs HF_TOKEN below).
# NOTE: set LLM_PREFER_FALLBACK=false, otherwise the fallback path collapses
# both tiers onto FALLBACK_LLM_PROVIDER and the hybrid never takes effect.
# HF free tier only includes ~$0.10/month of inference — fine for occasional
# deep calls/testing; upgrade to PRO ($9/mo, ~$2 credit) for sustained use.
# DEEP_THINK_PROVIDER=huggingface
# DEEP_THINK_LLM=deepseek-ai/DeepSeek-V3-0324
# QUICK_THINK_PROVIDER=ollama
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Auto-execution controls for demo/testing.
# Keep paper-only true unless you intentionally want real-money execution.
TRADINGAGENTS_AUTO_TRADE=false
TRADINGAGENTS_AUTO_TRADE_PAPER_ONLY=true
TRADINGAGENTS_TRADE_COMMENT=TradingAgent2.0
TRADINGAGENTS_MAX_RISK_PERCENT=0.5

# Optional native MT5 connection. Without these, the app uses the mock connector.
MT5_USE_MOCK=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# Cloud LLM API keys (only needed if switching away from local Ollama)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
