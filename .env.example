# Trading Mode: "paper" (demo/safe) or "live" (real money)
# WARNING: Set to "live" only when you're confident and ready for real trading!
# Default is "paper" for safety.
TRADING_MODE=paper

# LLM Provider — defaults to local Ollama (Owen) model, no API key required
# Change to "openai", "anthropic", etc. to use cloud providers
LLM_PROVIDER=ollama
DEEP_THINK_LLM=qwen3.6:latest
QUICK_THINK_LLM=qwen3.6:latest

# Cloud LLM API keys (only needed if switching away from local Ollama)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
