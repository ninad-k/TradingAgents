# Trading Mode: "paper" (demo/safe) or "live" (real money).
# Default is "live" — the dashboard reflects whichever MT5 terminal you attach to,
# so demo vs real is controlled by the terminal, not this flag.
# Auto-trading still requires explicit opt-in via TRADINGAGENTS_AUTO_TRADE.
TRADING_MODE=live

# LLM Provider — defaults to the cheapest local Qwen 2.5 Ollama model, no API key required
# Change to "openai", "anthropic", etc. to use cloud providers
LLM_PROVIDER=ollama
DEEP_THINK_LLM=qwen2.5:1.5b
QUICK_THINK_LLM=qwen2.5:1.5b
LLM_FALLBACK_ENABLED=true
LLM_PREFER_FALLBACK=true
FALLBACK_LLM_PROVIDER=ollama
FALLBACK_DEEP_THINK_LLM=qwen2.5:1.5b
FALLBACK_QUICK_THINK_LLM=qwen2.5:1.5b

# --- Hybrid: local Ollama for quick agents, Hugging Face for deep agents ---
# DEEP_THINK_PROVIDER / QUICK_THINK_PROVIDER override the provider per tier.
# When unset, both tiers use LLM_PROVIDER above. For a hybrid, keep the quick
# (high-volume) agents on free local Ollama and route only the deep/reasoning
# agents to Hugging Face's OpenAI-compatible router (needs HF_TOKEN below).
# NOTE: set LLM_PREFER_FALLBACK=false, otherwise the fallback path collapses
# both tiers onto FALLBACK_LLM_PROVIDER and the hybrid never takes effect.
# HF free tier only includes ~$0.10/month of inference — fine for occasional
# deep calls/testing; upgrade to PRO ($9/mo, ~$2 credit) for sustained use.
# DEEP_THINK_PROVIDER=huggingface
# DEEP_THINK_LLM=deepseek-ai/DeepSeek-V3-0324
# QUICK_THINK_PROVIDER=ollama
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Anthropic Claude recipe (needs ANTHROPIC_API_KEY below) ---
# Simple: LLM_PROVIDER=anthropic with claude-sonnet-5 on both tiers.
# Cheaper hybrid: keep the high-volume quick agents on Haiku and route only
# the deep/reasoning agents (researcher debate, trader, risk judge) to Sonnet.
# Set LLM_FALLBACK_ENABLED=false so a local fallback can't silently re-route
# the pipeline off Claude, and set TRADINGAGENTS_TOKEN_BUDGET_MAX (below) so
# spend is capped. Remember TRADINGAGENTS_MOCK_MODE=false or no LLM runs.
# QUICK_THINK_PROVIDER=anthropic
# QUICK_THINK_LLM=claude-haiku-4-5
# DEEP_THINK_PROVIDER=anthropic
# DEEP_THINK_LLM=claude-sonnet-5

# Auto-execution controls for demo/testing.
# Keep paper-only true unless you intentionally want real-money execution.
TRADINGAGENTS_AUTO_TRADE=false
TRADINGAGENTS_AUTO_TRADE_PAPER_ONLY=true
CODEX_STRATEGY_INTERVAL_SECONDS=0
CODEX_STRATEGY_SYMBOLS=BTCUSD
TRADINGAGENTS_TRADE_COMMENT=TradingAgent2.0
TRADINGAGENTS_MAX_RISK_PERCENT=0.5
TRADINGAGENTS_MAX_POSITION_SIZE=0.5
TRADINGAGENTS_MAX_TOTAL_VOLUME=2.0
TRADINGAGENTS_MAX_SYMBOL_POSITIONS=1
TRADINGAGENTS_TRADE_COOLDOWN_MINUTES=15
TRADINGAGENTS_MAX_CONSECUTIVE_LOSSES=3
TRADINGAGENTS_MAX_DAILY_LOSS_USD=500
TRADINGAGENTS_MIN_REWARD_COST_MULTIPLE=4
TRADINGAGENTS_ATR_STOP_MULTIPLIER=1.25
TRADINGAGENTS_SETUP_FILTER_ENABLED=true
TRADINGAGENTS_MAX_SPREAD_ATR_RATIO=0.40
TRADINGAGENTS_MIN_VOLUME_RATIO=0.20

# Optional native MT5 connection. Without these, the app uses the mock connector.
MT5_USE_MOCK=true
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: bind to a specific terminal INSTANCE. Must be the terminal
# executable (…\terminal64.exe), NOT the MetaQuotes\Terminal\<hash> data folder.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 IC Markets Global\terminal64.exe

# Market-data bar granularity for the Market Analyst.
# "auto" keeps the date-range picker (M15..D1); an explicit MT5 timeframe such
# as M1/M5/M15/H1/H4/D1 forces that granularity (e.g. M1 for 1-minute BTCUSD).
TRADINGAGENTS_MARKET_TIMEFRAME=auto

# "Stop Sonnet" LLM master switch + optional token budget cap.
# TRADINGAGENTS_LLM_ENABLED=false halts all LLM analysis (no token spend).
# TRADINGAGENTS_TOKEN_BUDGET_MAX>0 auto-disables the LLM once the running
# input+output token total crosses it. 0 = unlimited.
TRADINGAGENTS_LLM_ENABLED=true
TRADINGAGENTS_TOKEN_BUDGET_MAX=0

# Cloud LLM API keys (only needed if switching away from local Ollama)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
OPENROUTER_API_KEY=
