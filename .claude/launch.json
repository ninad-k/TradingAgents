{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--host", "127.0.0.1", "--port", "3009", "--clearScreen", "false"],
      "cwd": "tradingagents/frontend",
      "port": 3009
    },
    {
      "name": "backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "tradingagents.api.dashboard_api:app", "--host", "127.0.0.1", "--port", "8009"],
      "port": 8009
    }
  ]
}
